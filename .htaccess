# Arquivo principal
DirectoryIndex index.html

# Impede a listagem de diretórios
Options -Indexes

RewriteEngine On

# HTTPS e domínio canônico em um único redirecionamento
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.calculadoramaster\.com$ [NC]
RewriteRule ^ https://www.calculadoramaster.com%{REQUEST_URI} [R=301,L]

# URLs amigáveis: serve o arquivo .html sem exigir a extensão na URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Página 404 personalizada
ErrorDocument 404 /404.html
