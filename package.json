{
  "name": "calculadora-master",
  "version": "2.0.0",
  "description": "Calculadora Master - Calculadoras e ferramentas online gratuitas",
  "private": true,
  "scripts": {
    "validate:tools": "node scripts/validate-tools.js",
    "generate:catalog": "node scripts/generate-catalog.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "build:data": "node scripts/validate-tools.js && node scripts/generate-catalog.js && node scripts/generate-sitemap.js && node scripts/validate-tools.js",
    "build:html:pilot": "node scripts/build-html.js --scope=pilot",
    "build:html:financeiro": "node scripts/build-html.js --scope=financeiro",
    "build:html:tools": "node scripts/build-html.js",
    "build:html:site": "node scripts/build-html.js --scope=site",
    "build:html:blog": "node scripts/build-html.js --scope=blog",
    "build:html:institucional": "node scripts/build-html.js --scope=institucional",
    "verify:ssg": "npm test && npm run build:data && npm run build:html:tools && git diff --check",
    "audit:ssg": "node scripts/audit-ssg.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "calculadoras",
    "ferramentas",
    "financas",
    "saude",
    "trabalhista",
    "utilidades"
  ],
  "author": "Calculadora Master",
  "license": "ISC"
}
