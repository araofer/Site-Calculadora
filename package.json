{
  "name": "calculadora-master",
  "version": "2.0.0",
  "description": "Calculadora Master - Calculadoras e ferramentas online gratuitas",
  "private": true,
  "scripts": {
    "validate:tools": "node scripts/validate-tools.js",
    "generate:catalog": "node scripts/generate-catalog.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "build:data": "node scripts/validate-tools.js --source-only && node scripts/generate-catalog.js && node scripts/generate-sitemap.js && node scripts/validate-tools.js --source-only",
    "build:html:pilot": "node scripts/build-html.js --scope=pilot",
    "build:html:financeiro": "node scripts/build-html.js --scope=financeiro",
    "build:html:tools": "node scripts/build-html.js",
    "build:html:site": "node scripts/build-html.js --scope=site",
    "build:html:blog": "node scripts/build-html.js --scope=blog",
    "build:html:institucional": "node scripts/build-html.js --scope=institucional",
    "build:prod": "npm run build:data && node scripts/build-html.js --scope=prod && node scripts/validate-tools.js",
    "verify:ssg": "npm test && npm run build:prod && git diff --check",
    "audit:ssg": "node scripts/audit-ssg.js",
    "audit:prod": "node scripts/audit-prod.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:firestore": "firebase emulators:exec --only firestore \"node --test tests/firestore/firestore.rules.test.js\""
  },
  "keywords": [
    "calculadoras",
    "ferramentas",
    "financas",
    "saude",
    "trabalhista",
    "utilidades"
  ],
  "author": "Calculadora Master",
  "license": "ISC",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
